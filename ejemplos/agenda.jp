# 📒 Agenda persistente en JP — contactos que sobreviven al cierre
# Ejecuta: python -m jp ejemplos/agenda.jp
#
# Demuestra: archivos, diccionarios, separar/unir, romper/continuar.

variable archivo = "agenda_datos.txt"

# Carga los contactos guardados (formato: nombre|telefono por línea)
funcion cargar() {
    variable contactos = {}
    si existe_archivo(archivo) {
        para linea en separar(leer_archivo(archivo), "\n") {
            si longitud(linea) == 0 { continuar }
            variable partes = separar(linea, "|")
            contactos[partes[0]] = partes[1]
        }
    }
    devuelve contactos
}

# Guarda todos los contactos de vuelta al archivo
funcion guardar(contactos) {
    variable lineas = []
    para nombre en claves(contactos) {
        agregar(lineas, "{nombre}|{contactos[nombre]}")
    }
    escribir_archivo(archivo, unir(lineas, "\n") + "\n")
}

variable contactos = cargar()

muestra("=== MI AGENDA === (", longitud(contactos), "contactos guardados)")

mientras verdadero {
    muestra("")
    muestra("1) listar  2) agregar  3) buscar  4) salir")
    variable opcion = recortar(leer("Opción: "))

    si opcion == "1" {
        si longitud(contactos) == 0 {
            muestra("(agenda vacía)")
        }
        para nombre en claves(contactos) {
            muestra("  📞", nombre, "→", contactos[nombre])
        }
        continuar
    }

    si opcion == "2" {
        variable nombre = recortar(leer("Nombre: "))
        si longitud(nombre) == 0 { continuar }
        contactos[nombre] = recortar(leer("Teléfono: "))
        guardar(contactos)
        muestra("✓ Guardado")
        continuar
    }

    si opcion == "3" {
        variable nombre = recortar(leer("Nombre a buscar: "))
        si tiene(contactos, nombre) {
            muestra("  📞", nombre, "→", contactos[nombre])
        } sino {
            muestra("  No está en la agenda")
        }
        continuar
    }

    si opcion == "4" {
        muestra("¡Hasta pronto! Tus", longitud(contactos), "contactos quedaron guardados.")
        romper
    }

    muestra("(elige 1-4)")
}
