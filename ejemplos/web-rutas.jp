# El mini-framework web de biblioteca/web.jp, probado sin abrir red:
# app.atender(peticion) es justo lo que el servidor llama por dentro.

importar "../biblioteca/web.jp" como web

variable app = web.Aplicacion()
app.usar(funcion(p) {
    si p.cabeceras.tiene("x-clave") y p.cabeceras["x-clave"] != "secreta" {
        devuelve {cuerpo: "sin permiso", estado: 401}
    }
    devuelve nulo
})
app.get("/", funcion(p) { devuelve web.pagina("<h1>Portada</h1>") })
app.get("/saludar/:nombre", funcion(p) { devuelve "Hola " + p.parametros.nombre })
app.post("/api/suma", funcion(p) { devuelve web.json({total: p.json.a + p.json.b}, 201) })

funcion probar(metodo, ruta, cuerpo = "", cabeceras = {}) {
    variable p = {metodo: metodo, ruta: ruta, consulta: {}, cuerpo: cuerpo,
                  json: nulo, cabeceras: cabeceras}
    si cuerpo != "" { p["json"] = json_leer(cuerpo) }
    variable r = app.atender(p)
    imprime(metodo, ruta, "->", r.estado, "|", r.cuerpo)
}

probar("GET", "/")
probar("GET", "/saludar/Juan")
probar("POST", "/api/suma", json_texto({a: 2, b: 3}))
probar("GET", "/api/suma")
probar("GET", "/saludar/Otro", "", {"x-clave": "mala"})
probar("GET", "/nadie")
