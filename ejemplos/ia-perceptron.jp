# IA desde cero: un perceptron (una clase de JP) que aprende la tabla OR.
# Sin librerias externas: producto_punto y las listas hacen el trabajo.
# Aprende que [0,0] -> 0 y cualquier entrada con un 1 -> 1.

clase Perceptron {
    funcion iniciar(cantidad) {
        este.pesos = []
        para i en 1..cantidad { este.pesos.agregar(0) }
        este.sesgo = 0
    }
    funcion predecir(punto) {
        si producto_punto(este.pesos, punto) + este.sesgo >= 0 { devuelve 1 }
        devuelve 0
    }
    funcion entrenar(datos, metas, epocas = 20) {
        para epoca en 1..epocas {
            para i, punto en datos {
                variable error = metas[i] - este.predecir(punto)
                para j, entrada en punto {
                    este.pesos[j] = este.pesos[j] + error * entrada
                }
                este.sesgo = este.sesgo + error
            }
        }
    }
}

variable datos = [[0, 0], [0, 1], [1, 0], [1, 1]]
variable metas = [0, 1, 1, 1]

variable red = Perceptron(2)
red.entrenar(datos, metas)

imprime("pesos aprendidos:", red.pesos, "sesgo:", red.sesgo)
para i, punto en datos {
    imprime("{punto} -> {red.predecir(punto)} (esperado {metas[i]})")
}
