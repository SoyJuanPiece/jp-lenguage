# 🎯 Ahorcado en JP — palabra secreta con 6 vidas
# Ejecuta: python -m jp ejemplos/ahorcado.jp

variable palabra = "programacion"
variable usadas = []
variable aciertos = []
variable vidas = 6

# el tablero: guiones por cada letra que falta
funcion tablero() {
    variable linea = ""
    para letra en palabra {
        si aciertos.contiene(letra) {
            linea = "{linea}{letra} "
        } sino {
            linea = "{linea}_ "
        }
    }
    devuelve linea
}

muestra("=== AHORCADO ===")
muestra("La palabra tiene", palabra.longitud(), "letras. Tienes", vidas, "vidas.")

mientras verdadero {
    muestra("")
    muestra(tablero())
    si aciertos.longitud() > 0: muestra("Usadas:", unir(usadas, ", "))

    variable letra = leer("Letra: ").recortar().minusculas()
    si letra.longitud() != 1 {
        muestra("Escribe UNA letra.")
        continuar
    }
    si usadas.contiene(letra) {
        muestra("Ya probaste", letra, "...")
        continuar
    }
    usadas.agregar(letra)

    si palabra.contiene(letra) {
        aciertos.agregar(letra)
        muestra("¡Bien! La", letra, "está.")
    } sino {
        vidas = vidas - 1
        muestra("La", letra, "no está. Te quedan", vidas, "vidas.")
        si vidas == 0 {
            muestra("💀 Sin vidas. La palabra era:", palabra)
            romper
        }
    }

    # ¿ganó? todas las letras de la palabra están en aciertos
    variable completa = verdadero
    para l en palabra {
        si no aciertos.contiene(l) {
            completa = falso
            romper
        }
    }
    si completa {
        muestra("🎉 ¡GANASTE! La palabra era:", palabra)
        romper
    }
}
